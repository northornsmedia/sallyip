{
  "framework": "vite",
  "build": {
    "env": {
      "UV_LINK_MODE": "copy"
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/api/generate-file", "destination": "/api/generate-file.py" },
    { "source": "/api/ingest-document", "destination": "/api/ingest-document.py" },
    { "source": "/api/:path*", "destination": "/api/[...path].js" }
  ]
}
