# Copy to .env.local and fill values. NEVER commit .env / .env.local / .ai-keys.local.json
# (git-ignored; CI enforces via .github/workflows/secret-scan.yml).
# Every key below is read somewhere in code; blanks mean "not configured".

# --- Core ---
DATABASE_URL=replace_with_neondb_owner_url
DATABASE_URL_ADMIN=replace_with_neondb_owner_url
DATABASE_URL_APP=replace_with_sally_app_url
DATABASE_URL_READONLY=replace_with_sally_readonly_url
APP_ORIGIN=https://sallyip.com
API_ORIGIN=https://sallyip.com
NODE_ENV=development
SALLYIP_ENV=development
SALLYIP_EXECUTION_MODE=PUBLIC_RESEARCH
SALLYIP_APPROVE_GEMINI_CONFIDENTIAL=0
SALLYIP_DISABLE_FALLBACK=0
SALLYIP_STRICT_PRIMARY=0
SALLYIP_MAX_TOKENS=
SALLYIP_ALLOWED_HOSTS=
SALLYIP_EXTRA_ENGINES=

# --- Primary engine (Gemini; read by src/lib/sally-orchestrator.js, benchmark-eval-framework.js) ---
GEMINI_API_KEY=replace_with_your_gemini_key
GOOGLE_API_KEY=replace_with_your_gemini_key
SALLYIP_MODEL=gemini-flash-lite-latest
SALLYIP_PRIMARY_MODEL=gemini-flash-lite-latest
SALLYIP_PRIMARY_KEY=GEMINI_API_KEY
SALLYIP_PRIMARY_NAME=Gemini Flash Lite
SALLYIP_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SALLYIP_PRIMARY_WEIGHT=100

# --- OpenRouter family (src/lib/sally-orchestrator.js, api/_handlers/speech.js) ---
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_EMBEDDING_API_KEY=
SALLYIP_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
OPENROUTER_RERANK_API_KEY=
SALLYIP_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
OPENROUTER_LFM_CHAT_API_KEY=
SALLYIP_LFM_CHAT_MODEL=
OPENROUTER_GEMMA_API_KEY=
SALLYIP_GEMMA_MODEL=
OPENROUTER_OX_API_KEY=
SALLYIP_OX_MODEL=
OPENROUTER_DOTS_API_KEY=
SALLYIP_DOTS_MODEL=
OPENROUTER_SPEECH_API_KEY=
SALLYIP_SPEECH_MODEL=
SALLYIP_STT_MODEL=openai/whisper-large-v3-turbo
EDGE_TTS_VOICE=en-US-AriaNeural

# --- Official search (src/lib/official-search-service.js) ---
EPO_OPS_KEY=
EPO_OPS_SECRET=
EUIPO_CLIENT_ID=
EUIPO_CLIENT_SECRET=
EUIPO_AUTH_URL=https://auth.euipo.europa.eu/oidc/accessToken
EUIPO_API_BASE=https://api.euipo.europa.eu
USPTO_API_KEY=
USPTO_API_BASE=https://api.uspto.gov/patents/v1
COURTLISTENER_TOKEN=
COURTLISTENER_COURT=
COURTLISTENER_API_BASE=https://www.courtlistener.com/api/rest/v3

# --- Ops / admin / gateways ---
BRAIN_ADMIN_USERNAME=admin
BRAIN_ADMIN_PASSWORD=
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
NVIDIA_API_KEY=
