    "SPECIALIST_REVIEW_REQUIRED",
    "TERMINOLOGY_CONFLICT_DETECTED",
    "DRAWING_CONSISTENCY_REVIEW_REQUIRED"
  ],
  "output_formats": ["docx", "pdf", "md"],
