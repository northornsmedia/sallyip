  "required_inputs": [
    {
      "id": "article_name",
      "label": "Article Name",
      "type": "text",
      "input_class": "REQUIRED_BEFORE_DRAFT",
      "description": "Name of the article of manufacture the design relates to (e.g., 'Smart Speaker', 'Mobile Phone', 'Furniture Item')"
    },
    {
      "id": "design_title",
      "label": "Design Title",
      "type": "text",
      "input_class": "REQUIRED_BEFORE_DRAFT",
      "description": "Title for the design patent application (USPTO prefers neutral article name)"
    },
    {
      "id": "design_type",
      "label": "Design Type",
      "type": "select",
      "input_class": "REQUIRED_BEFORE_DRAFT",
      "options": [
        "PHYSICAL_PRODUCT",
        "PARTIAL_PRODUCT",
        "SURFACE_ORNAMENTATION",
        "GUI",
        "ICON",
        "DISPLAY_SCREEN",
        "PACKAGING",
        "FURNITURE",
        "DEVICE",
        "CONTAINER",
        "WEARABLE",
        "OTHER"
      ],
      "description": "Type of design being protected"
    },
    {
      "id": "claimed_portion",
      "label": "Claimed Portion",
      "type": "select",
      "input_class": "REQUIRED_BEFORE_DRAFT",
      "options": ["ENTIRE_ARTICLE", "PORTION_OF_ARTICLE"],
      "description": "Whether the claim covers the entire article or a specific portion"
    },
    {
      "id": "inventors",
      "label": "Inventors",
      "type": "array",
      "input_class": "REQUIRED_BEFORE_DRAFT",
      "description": "Natural persons who contributed to the ornamental design conception"
    },
    {
      "id": "jurisdiction",
      "label": "Filing Jurisdiction",
      "type": "select",
      "input_class": "REQUIRED_BEFORE_DRAFT",
      "default": "US",
      "options": ["US"]
    }
  ],
  "optional_inputs": [
    {
      "id": "ornamental_features",
      "label": "Ornamental Features",
      "type": "textarea",
      "input_class": "RECOMMENDED",
      "description": "Description of the visually distinctive ornamental features"
    },
    {
      "id": "design_description",
      "label": "Design Description",
      "type": "textarea",
      "input_class": "RECOMMENDED",
      "description": "Overall design concept and ornamental appearance"
    },
    {
      "id": "whole_vs_partial",
      "label": "Whole Article vs Partial Design Detail",
      "type": "textarea",
      "input_class": "RECOMMENDED",
      "description": "If partial design, identify claimed ornamental portion and unclaimed/environmental portions"
    },
    {
      "id": "surface_ornamentation",
      "label": "Surface Ornamentation",
      "type": "boolean",
      "input_class": "OPTIONAL",
      "description": "Whether the design includes surface ornamentation"
    },
    {
      "id": "configuration_shape",
      "label": "Configuration/Shape",
      "type": "boolean",
      "input_class": "OPTIONAL",
      "description": "Whether the design includes configuration or shape features"
    },
    {
      "id": "physical_or_gui",
      "label": "Physical Product or GUI",
      "type": "select",
      "input_class": "RECOMMENDED",
      "options": ["PHYSICAL", "GUI", "ICON", "DISPLAY_SCREEN", "BOTH"],
      "description": "Whether the design is for a physical product, GUI, icon, or display screen"
    },
    {
      "id": "transparency_translucency",
      "label": "Transparency/Translucency",
      "type": "boolean",
      "input_class": "OPTIONAL",
      "description": "Whether transparent or translucent portions exist"
    },
    {
      "id": "colour_significance",
      "label": "Colour Significance",
      "type": "select",
      "input_class": "OPTIONAL",
      "options": ["CLAIMED", "ILLUSTRATIVE", "NOT_APPLICABLE"],
      "description": "Whether colour is claimed as part of the design"
    },
    {
      "id": "unclaimed_features",
      "label": "Unclaimed/Environmental Features",
      "type": "textarea",
      "input_class": "OPTIONAL",
      "description": "Features shown in drawings but not claimed (broken lines)"
    },
    {
      "id": "multiple_embodiments",
      "label": "Multiple Embodiments",
      "type": "boolean",
      "input_class": "OPTIONAL",
      "description": "Whether there are multiple embodiments or closely related variants"
    },
    {
      "id": "embodiments_detail",
      "label": "Embodiments Detail",
      "type": "textarea",
      "input_class": "OPTIONAL",
      "description": "Description of each embodiment and its distinguishing features"
    },
    {
      "id": "gui_display_article",
      "label": "GUI Display Article",
      "type": "text",
      "input_class": "OPTIONAL",
      "description": "For GUI designs: what display/article the GUI appears on (e.g., 'mobile phone screen', 'vehicle dashboard')"
    },
    {
      "id": "gui_static_animated",
      "label": "GUI Static or Animated",
      "type": "select",
      "input_class": "OPTIONAL",
      "options": ["STATIC", "ANIMATED", "SEQUENCE"],
      "description": "For GUI designs: whether the design is static, animated, or a sequence of states"
    },
    {
      "id": "gui_states",
      "label": "GUI States/Frames",
      "type": "number",
      "input_class": "OPTIONAL",
      "description": "For animated GUIs: number of states or frames"
    },
    {
      "id": "gui_transitions",
      "label": "GUI Transitions",
      "type": "textarea",
      "input_class": "OPTIONAL",
      "description": "For animated GUIs: description of transitions between states"
    },
    {
      "id": "applicant",
      "label": "Applicant / Assignee",
      "type": "text",
      "input_class": "OPTIONAL"
    },
    {
      "id": "priority_claims",
      "label": "Priority / Related Applications",
      "type": "array",
      "input_class": "OPTIONAL"
    },
    {
      "id": "public_disclosures",
      "label": "Public Disclosures",
      "type": "array",
      "input_class": "OPTIONAL"
    },
    {
      "id": "existing_products",
      "label": "Existing Products / Known Similar Designs",
      "type": "array",
      "input_class": "OPTIONAL"
    },
    {
      "id": "available_views",
      "label": "Available Drawing Views",
      "type": "array",
      "input_class": "RECOMMENDED",
      "options": ["PERSPECTIVE", "FRONT", "REAR", "LEFT", "RIGHT", "TOP", "BOTTOM"],
      "description": "Drawing views available or planned"
    },
    {
      "id": "line_treatment",
      "label": "Line Treatment Understanding",
      "type": "select",
      "input_class": "RECOMMENDED",
      "options": ["SOLID_CLAIMED_BROKEN_UNCLAIMED", "NOT_CONFIRMED"],
      "description": "Whether solid lines = claimed design, broken lines = unclaimed/environmental"
    }
  ],
